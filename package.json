{
  "name": "molecule-next",
  "private": true,
  "version": "0.1.0",
  "description": "Molecule Next — modern Web IDE shell with plugins and AI",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@easyspace/reference-ide",
    "lint": "turbo run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "build:extensions": "node scripts/build-extensions.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "esbuild": "^0.25.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
