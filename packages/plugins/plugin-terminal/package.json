{
  "name": "@jiulimiai/plugin-terminal",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts --clean --external react --external @xterm/xterm --external @xterm/addon-fit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jiulimiai/plugin-api": "workspace:*",
    "@jiulimiai/plugin-runtime": "workspace:*",
    "@jiulimiai/workbench": "workspace:*",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/easyspace-ai/molecule.git",
    "directory": "packages/plugins/plugin-terminal"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
